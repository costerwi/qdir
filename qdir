def getJobInfo(qFilePath: Path) -> dict[str, str]:
    """Return jobId, user, and command to be run by the qFilePath"""
    info = {"jobId": qFilePath.stem, "owner": qFilePath.owner()}
    try:
        with qFilePath.open() as qFile:
            for line in qFile:
                strip = line.strip()
                info["status"] = strip  # capture last line
                info.setdefault("name", strip)  # capture first line
    except Exception as e:
        if options.verbose >= 3:
            print(e, file=sys.stderr)
    return info


def getQueuedJobs():
    "Return a list of qFilePath for currently queued jobs, sorted oldest to newest"

    # Collecct a set of active process ids
    if os.name == "nt":
        import win32process

        processIds = set(str(pid) for pid in win32process.EnumProcesses())
    else:
        cmd = ["pgrep", "python"]
        processIds = {
            pid
            for pid in subprocess.check_output(cmd, universal_newlines=True).split()
            if pid.isnumeric()
        }

    def is_qFile(path):
        """Verify the path is an active job file with a matching process id"""
        if not path.stem.isnumeric():
            return False  # file name must be an integer
        if not (path.is_file()):
            return False  # path must represent a file
        if path.stem in processIds:
            return True  # file name must match a running process number

        # Otherwise, the process may have died or the computer was rebooted with
        # this job in the queue. This orphaned queue may be removed.
        print(
            "Removing orphaned queue file",
            options.info.format(**getJobInfo(path)),
            file=sys.stderr,
        )
        try:
            path.unlink()
        except OSError as e:
            print(e, file=sys.stderr)

    queuedJobs = [
        filePath
        for filePath in options.qdir.glob("*" + qFileSuffix)
        if is_qFile(filePath)
    ]
    return sorted(queuedJobs, key=lambda qFilePath: qFilePath.stat().st_mtime)


def qstat():
    "Print a list of queued jobs"
    if options.verbose >= 2:
        print("Queue directory", options.qdir)
    queuedJobs = getQueuedJobs()
    if not queuedJobs and options.verbose >= 2:
        print("No jobs queued")
    else:
        if options.verbose >= 1:
            print(
                options.info.format(
                    jobId="JobId", owner="Owner", status="Status", name="Name"
                )
            )
        for qFilePath in queuedJobs:
            print(options.info.format(**getJobInfo(qFilePath)))


def parseArguments(argv: list[str]) -> Namespace:
    """Parse the given list of arguments

    Uses commandline arguments for top priority followed by in-file directives
    and lastly default values.

    In-file directives are the same format as commandline options and should
    occur in comment lines at the beginning of the job script.
    Directive lines and are preceeded by the dprefix regular expression.
    """

    import re
    import shlex

    # Parse commandline arguments to find cmd
    argvNamespace = parser.parse_args(argv)

    # Scan args[0] for optional file directives
    directives = []
    dprefixRe = re.compile(dprefix)
    commentRe = re.compile("(#|@?(?i:rem))")
    try:
        with open(argvNamespace.args[0]) as jobScript:
            for line in jobScript:
                m = dprefixRe.match(line)
                if m:
                    directives.extend(shlex.split(line[m.end() :]))
                elif len(line.strip()) == 0:
                    continue  # ignore blank lines
                elif commentRe.match(line):
                    continue  # ignore non-directive comment lines
                else:
                    break  # otherwise stop processing
    except:
        pass
    _, unknown = parser.parse_known_args(directives)

    # Finally, parse the combined options with priority for argv
    options, _ = parser.parse_known_args(directives + argv)

    # Always overwrite these options which must come from argv
    argvOnly = "args", "dequeue", "full"
    vars(options).update({k: vars(argvNamespace).get(k) for k in argvOnly})

    if not options.name and len(options.args) > 0:
        options.name = options.args[0]  # default name
    if unknown and options.verbose >= 2:
        print("WARNING: Unknown file directives", *unknown, file=sys.stderr)
    if options.verbose >= 5:
        print("Arguments", argv, file=sys.stderr)
        print("Directives", directives, file=sys.stderr)
        print("options", options, file=sys.stderr)
    return options


def enqueue(cmd: list[str]):
    "Submit cmd to the job queue"
    import shutil

    previousJobs = getQueuedJobs()
    if os.name == "posix":
        # fork to background TODO similar for windows
        if os.fork():
            os._exit(0)

    jobId = str(os.getpid())  # process id of this script
    job = None  # subprocess running the cmd, if any
    qFile = None  # qFile associated with this job
    startTime = perf_counter()  # time job was enqueued
    if not shutil.which(cmd[0]) and options.verbose >= 1:
        print("WARNING: {} is not in PATH".format(cmd[0]), file=sys.stderr)

    def terminateJob(sig=None, frame=None):
        """Terminate this job if running or dequeue if not"""
        nonlocal job
        result = ""
        runTime = " after " + humanDuration(perf_counter() - startTime)
        if qFile and exists(qFile.name):
            os.unlink(qFile.name)  # remove job file
        if hasattr(job, "pid"):  # job is or was running
            if job.poll() is None:
                if options.verbose >= 2:
                    result = "Killed"
                if os.name == "posix":
                    # pass SIGTERM signal to all child processes in this process group
                    try:
                        os.killpg(os.getpgid(job.pid), signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                else:
                    job.send_signal(signal.CTRL_BREAK_EVENT)
                    sleep(options.interval)
                    job.terminate()
            elif options.verbose >= 1:
                if job.returncode <= 0:
                    result = "Done"
                else:
                    result = "Error"
        elif job is None and options.verbose >= 2:
            # removed from the queue before starting
            result = "Dequeued"
        if result:
            print(jobId, options.name, result + runTime, sep="\t", file=sys.stderr)
            job = result  # don't report result again

    signal.signal(signal.SIGTERM, terminateJob)  # catch termination signal

    # Create the qFile in qdir directory with its name matching this jobId
    with (options.qdir / jobId).with_suffix(qFileSuffix).open("w") as qFile:
        os.environ["QDIR_FILE"] = qFile.name  # will be exported to cmd
        status = "Queued " + asctime()
        if options.verbose >= 2:
            print(jobId, options.name, status, sep="\t")
        os.close(sys.stdout.fileno())  # allow shell to collect qFile.name
        sys.stdout = open(os.devnull, "w")  # block further printing to stdout

        print(options.name, file=qFile)  # qFile contents are for information only
        if previousJobs:
            print(
                "Behind",
                " ".join([job.stem for job in previousJobs]),
                file=qFile,
            )
        print(status, file=qFile)

    # Wait for all previousJobs to complete
    previousJobs.reverse()  # check newest jobs first
    while exists(qFile.name) and any(otherFile.exists() for otherFile in previousJobs):
        sleep(options.interval)

    # Launch the cmd only if this job's qFile still exists
    if exists(qFile.name):
        try:
            # Append the job starting status to qFile
            stat = os.stat(qFile.name)
            with open(qFile.name, "a") as qFile:
                print("Waited", humanDuration(perf_counter() - startTime), file=qFile)
                print("Started", asctime(), file=qFile)
            # Keep mtime unchanged so the job files sort correctly
            os.utime(qFile.name, (stat.st_atime, stat.st_mtime))
        except Exception:
            pass  # ignore any status update exceptions
        name = options.name
        owner = os.getlogin()
        logFilePath = Path(options.output.format(**locals()))
        with logFilePath.open("w") as logFile:
            opts = {}
            if os.name == "nt":
                opts["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP
            try:
                job = subprocess.Popen(
                    cmd,
                    shell=False,
                    start_new_session=True,
                    stdout=logFile,
                    stderr=subprocess.STDOUT,
                    **opts,
                )
                startTime = perf_counter()  # reset to time job started running
                while exists(qFile.name) and job.poll() is None:
                    # job is still running
                    sleep(options.interval)
            except Exception as e:
                print(e, file=logFile)

    terminateJob()  # Clean up at the end


def fullDetails(jobList: list[str]):
    "Report full details about specified jobs"
    queuedJobs: dict[Path, dict] = {}
    queuedJobs.update(
        [(qFilePath, getJobInfo(qFilePath)) for qFilePath in getQueuedJobs()]
    )
    if not queuedJobs and options.verbose >= 2:
        print("No jobs queued")
    if not jobList:
        jobList = [qFileInfo["jobId"] for qFileInfo in queuedJobs.values()]

    jobOptions = options
    while len(jobList) > 0:
        hits = 0
        for qFilePath, qFileInfo in queuedJobs.items():
            if not qFileInfo:
                continue
            if jobList[0] == qFileInfo["jobId"] or jobOptions.name == qFileInfo["name"]:
                print(
                    "\nJobId: {jobId}\nOwner: {owner}\nName: ".format(**qFileInfo),
                    end="",
                )
                try:
                    with open(qFilePath) as qFile:
                        for line in qFile:
                            print(line, end="")
                except:
                    print()
                qFileInfo.clear()  # Prevent repeated matches
                hits += 1
        if hits == 0 and options.verbose >= 1:
            print(jobList[0], "is not queued", file=sys.stderr)
        jobList.pop(0)
        jobOptions = parseArguments(jobList)


def dequeueJobs(jobList: list[str]):
    "Remove a list of jobIds or job names from the queue"
    if not jobList:
        sys.exit("ERROR: No jobs specified to dequeue")
    queuedJobs: dict[Path, dict] = {}
    queuedJobs.update(
        [(qFilePath, getJobInfo(qFilePath)) for qFilePath in getQueuedJobs()]
    )

    jobOptions = options
    while len(jobList) > 0:
        hits = 0
        for qFilePath, qFileInfo in queuedJobs.items():
            if jobList[0] == qFileInfo.get("jobId") or jobOptions.name == qFileInfo.get(
                "name"
            ):
                if options.verbose >= 3:
                    print("Dequeing", options.info.format(**qFileInfo))
                qFilePath.unlink()  # Simply delete the qFile
                qFileInfo.clear()  # Prevent repeated matches
                hits += 1
        if hits == 0 and options.verbose >= 1:
            print(jobList[0], "is not queued", file=sys.stderr)
        jobList.pop(0)
        jobOptions = parseArguments(jobList)


def humanDuration(seconds: float) -> str:
    for unit, per in ("days", 86400), ("hours", 3600), ("minutes", 60):
        if seconds >= 1.1 * per:
            return "{:.2g} {}".format(seconds / per, unit)
    return "{:.2g} seconds".format(seconds)


if __name__ == "__main__":
    options = parseArguments(sys.argv[1:])
    if not options.qdir.is_dir():
        sys.exit(f"ERROR: The QDIR directory {options.qdir} does not exist")
    if not os.access(options.qdir, os.W_OK):
        sys.exit(f"ERROR: The QDIR directory {options.qdir} is not writable")
    if not options.interval > 0:
        sys.exit(
            f"The QDIR_POLL_INTERVAL {options.interval} must be seconds greater than 0"
        )

    if options.full:
        # Report detailed information about jobs in the queue
        fullDetails(options.args)
    elif options.dequeue:
        # Dequeue these jobId numbers or job names
        dequeueJobs(options.args)
    elif len(options.args) == 0:
        # No arguments: Report a list of jobs in the queue
        qstat()
    else:
        # Enqueue a new command
        enqueue(options.args)
