#!/bin/env python3
"""qdir implements first-in, first-out sequential job queue for the local machine.

The queue is maintained as a directory of tiny job queue files (.q files).
When a new job is submitted it will make a list of all job queue files ahead of it and then create its own queue file in the queue directory.
The job will not execute its command until all of the preceeding job queue files are gone.
Once a command is completed the job will remove its queue file.

Multiple users should share the same queue directory to ensure one job is executed at a time among the group of users.
The Linux default location is the system /tmp directory which requires no additional configuration for multiple users.
The Windows default location will be the user's temporary directory which will work fine on a single user machine.
An alternative directory may be selected by predefining the QDIR environment variable.

Usage:
    The behavior is different depending on the arguments

    # Add a job to the queue:
    qdir cmd [with optional arguments]

    # List the currently queued jobs:
    qdir

    # Dequeue or terminate a list of jobId numbers
    qdir jobId [jobId ...]

    # Show this help
    qdir help

Carl Osterwisch, January 2024
"""

__version__ = "0.11.0"

from argparse import ArgumentParser
import os
from os.path import exists
from pathlib import Path
import signal
import subprocess
import sys
from tempfile import gettempdir
from time import sleep, asctime, perf_counter

parser = ArgumentParser()
parser.add_argument('-N', '--name',
        help='Name for the job',
        default=os.environ.get("PBS_JOBNAME"))
parser.add_argument('-q', '--qdir',
        help='Directory to store the queue files',
        type=Path, default=os.environ.get("QDIR", gettempdir()))
parser.add_argument('-c', '--interval', type=int,
        help='Polling interval in seconds',
        default=int(os.environ.get("QDIR_POLL_INTERVAL", 10)))
parser.add_argument('-o', '--output',
        help='Output file name',
        default=os.environ.get("QDIR_LOGNAME", "{name}._{jobId}"))
parser.add_argument('-v', '--verbose', type=int,
        help='Verbosity level',
        default=os.environ.get("QDIR_VERBOSE", 2))
parser.add_argument('args', nargs='*')

qFileSuffix = os.environ.get("QDIR_SUFFIX", ".qdir")
dprefix = os.environ.get("QDIR_DPREFIX", os.environ.get("PBS_DPREFIX", "#(QDIR|PBS)"))

if os.name == 'nt':
    def winOwner(self):
        "Return name of the WindowsPath owner"
        try:
            import win32security
        except ImportError:
            if options.verbose >= 3:
                print("Unable to determine owner without win32security module",
                        file=sys.stderr)
            return "unknown"
        sd = win32security.GetFileSecurity(str(self), win32security.OWNER_SECURITY_INFORMATION)
        owner_sid = sd.GetSecurityDescriptorOwner()
        name, domain, type = win32security.LookupAccountSid(None, owner_sid)
        return name
    try:
        _ = qdir.owner()  # test if Path has owner method
    except NotImplementedError:
        Path.owner = winOwner  # monkey patch if needed


def getJobInfo(qFilePath):
    """Return jobId, user, and command to be run by the qFilePath"""
    info = [qFilePath.stem, qFilePath.owner()]
    try:
        cmd = ""
        with qFilePath.open() as qFile:
            for line in qFile:
                status = line.strip() # capture last line
                cmd = cmd or status # capture first line
        info.extend([status, cmd])
    except Exception as e:
        if options.verbose >= 3: print(e, file=sys.stderr)
    return info


def getQueuedJobs():
    "Return a list of qFilePath for currently queued jobs, sorted oldest to newest"

    # Collecct a set of active process ids
    if os.name == 'nt':
        import win32process
        processIds = set(str(pid) for pid in win32process.EnumProcesses())
    else:
        cmd = ["pgrep", "python"]
        processIds = {
            pid
            for pid in subprocess.check_output(cmd, universal_newlines=True).split()
            if pid.isnumeric()
        }

    def is_qFile(path):
        """Verify the path is an active job file with a matching process id"""
        if not path.stem.isnumeric():
            return False  # file name must be an integer
        if not (path.is_file()):
            return False  # path must represent a file
        if path.stem in processIds:
            return True  # file name must match a running process number

        # Otherwise, the process may have died or the computer was rebooted with
        # this job in the queue. This orphaned queue may be removed.
        print("Removing orphaned queue file", *getJobInfo(path), sep="\t", file=sys.stderr)
        try:
            path.unlink()
        except OSError as e:
            print(e, file=sys.stderr)

    queuedJobs = [filePath for filePath in
            options.qdir.glob("*" + qFileSuffix) if is_qFile(filePath)]
    return sorted(queuedJobs, key=lambda qFilePath: qFilePath.stat().st_mtime)


def qstat():
    "Print a list of queued jobs"
    if options.verbose >= 2:
        print("Queue directory", options.qdir)
    queuedJobs = getQueuedJobs()
    if not queuedJobs:
        print("No jobs queued")
    else:
        if options.verbose >= 1:
            print("JobId", "User", "Status" + 26*' ', "Name", sep="\t")
        for qFilePath in queuedJobs:
            print(*getJobInfo(qFilePath), sep="\t")


def parseArguments(argv):
    import re
    import shlex

    # Parse arguments to find cmd
    options, unknown = parser.parse_known_args(argv)

    args = options.args

    # Scan cmd script for optional directives
    directives = []
    dprefixRe = re.compile(dprefix)
    try:
        with open(argv[0]) as jobScript:
            for line in jobScript:
                m = dprefixRe.match(line)
                if m:
                    directives.extend(shlex.split(line[m.end():]))
                elif any(line.startswith(ch) for ch in ('#', ':')):
                    continue  # ignore comment lines
                elif len(line.strip()) == 0:
                    continue  # ignore blank lines
                else:
                    break  # otherwise stop processing
    except:
        pass

    # Parse directives and commandline arguments
    options, unknown = parser.parse_known_args(directives + argv)
    del options.args  # directives may not set args
    if not options.name and len(args) > 0:
        options.name = args[0]
    if unknown and options.verbose >= 2:
        print('Unknown arguments', *unknown, file=sys.stderr)
    if options.verbose >= 5:
        print('Arguments', argv, file=sys.stderr)
        print('Directives', directives, file=sys.stderr)
        print('options', options, file=sys.stderr)
        print('args', args, file=sys.stderr)
    return args, options


def enqueue(cmd):
    "Submit cmd to the job queue"
    previousJobs = getQueuedJobs()
    if os.name == "posix":
        # fork to background TODO similar for windows
        if os.fork():
            os._exit(0)

    jobId = str(os.getpid())  # process id of this script
    job = None  # subprocess running the cmd, if any
    qFile = None  # qFile associated with this job

    def terminateJob(sig=None, frame=None):
        """Terminate this job if running or dequeue if not"""
        nonlocal job
        result = ""
        runTime = ""
        if qFile and exists(qFile.name):
            os.unlink(qFile.name)  # remove job file
        if hasattr(job, 'pid'):  # job is or was running
            runTime = humanDuration(perf_counter() - job.startTime)
            if job.poll() is None:
                if options.verbose >= 2:
                    result = "Killed"
                if os.name == "posix":
                    # pass SIGTERM signal to all child processes in this process group
                    try:
                        os.killpg(os.getpgid(job.pid), signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                else:
                    job.send_signal(signal.CTRL_BREAK_EVENT)
                    sleep(options.interval)
                    job.terminate()
            elif options.verbose >= 1:
                if job.returncode <= 0:
                    result = "Done"
                else:
                    result = "Error"
        elif job is None and options.verbose >= 2:
            # removed from the queue before starting
            result = "Dequeued"
        if result:
            print(jobId, result, runTime, options.name, sep="\t", file=sys.stderr)
            job = result  # don't report result again

    signal.signal(signal.SIGTERM, terminateJob)  # catch termination signal

    # Create the qFile in qdir directory with its name matching this jobId
    with (options.qdir/jobId).with_suffix(qFileSuffix).open("w") as qFile:
        os.environ["QDIR_FILE"] = qFile.name  # will be exported to cmd
        status = " Queued " + asctime()
        if options.verbose >= 2:
            print(jobId, status, options.name, sep='\t')
        os.close(sys.stdout.fileno())  # allow shell to collect qFile.name
        sys.stdout = open(os.devnull, "w")  # block further printing to stdout

        print(options.name, file=qFile)  # qFile contents are for information only
        if previousJobs:
            print(
                "Behind",
                " ".join([job.stem for job in previousJobs]),
                file=qFile,
            )
        print(status, file=qFile)

    # Wait for all previousJobs to complete
    previousJobs.reverse()  # check newest jobs first
    while exists(qFile.name) and any(otherFile.exists() for otherFile in previousJobs):
        sleep(options.interval)

    # Launch the cmd only if this job's qFile still exists
    if exists(qFile.name):
        try:
            # Append the job starting status to qFile
            stat = os.stat(qFile.name)
            with open(qFile.name, 'a') as qFile:
                print('Started', asctime(), file=qFile)
            # Keep mtime unchanged so the job files sort correctly
            os.utime(qFile.name, (stat.st_atime, stat.st_mtime))
        except Exception:
            pass # ignore any status update exceptions
        name = options.name
        logFilePath = Path(options.output.format(**locals()))
        with logFilePath.open("w") as logFile:
            opts = {}
            if os.name == "nt":
                opts['creationflags'] = subprocess.CREATE_NEW_PROCESS_GROUP
            try:
                job = subprocess.Popen(
                    cmd,
                    shell=False,
                    start_new_session=True,
                    stdout=logFile,
                    stderr=subprocess.STDOUT,
                    **opts,
                )
                job.startTime = perf_counter()
                while exists(qFile.name) and job.poll() is None:
                    # job is still running
                    sleep(options.interval)
            except Exception as e:
                print(e, file=logFile)

    terminateJob() # Clean up at the end


def dequeueJobs(jobIdList):
    "Remove a list of jobIds from the queue"
    queuedJobs = getQueuedJobs()
    for jobId in jobIdList:
        qFilePath = (options.qdir/str(jobId)).with_suffix(qFileSuffix)
        if not qFilePath in queuedJobs:
            print(jobId, 'is not queued')
        else:
            print('Dequeing', *getJobInfo(qFilePath), sep='\t')
            qFilePath.unlink() # Simply delete the qFile


def humanDuration(seconds):
    for unit, per in ('days', 86400), ('hours', 3600), ('minutes', 60):
        if seconds >= 1.1*per:
            return('{:.2g} {}'.format(seconds/per, unit))
    return('{:.2g} seconds'.format(seconds))


if __name__ == "__main__":
    args, options = parseArguments(sys.argv[1:])
    if not options.qdir.is_dir():
        sys.exit(f"ERROR: The QDIR directory {options.qdir} does not exist")
    if not os.access(options.qdir, os.W_OK):
        sys.exit(f"ERROR: The QDIR directory {options.qdir} is not writable")
    if not options.interval > 0:
        sys.exit(f"The QDIR_POLL_INTERVAL {interval} must be seconds greater than 0")

    if len(args) == 0:
        # No arguments: Display a list of jobs in the queue
        qstat()
    elif all(arg.isnumeric() for arg in args):
        # All integer arguments: Dequeue these jobId numbers
        dequeueJobs(args)
    else:
        # Enqueue a new command
        enqueue(args)
