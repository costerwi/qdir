#!/bin/env python3
"""Implements first-in, first-out sequential job queue for the local machine.

The queue is maintained as a directory of job queue files.
A job will execute once all of the preceeding job queue files are deleted.
A finished job will delete its own job queue file which signals the next job to begin.
Users may manually delete job queue files to skip or terminate their corresponding jobs.

Multiple users may share the same queue directory to ensure one job is executed at a time among the group of users.
The default queue directory is /var/spool/qdir but any convenient directory may be selected by defining the QDIR environment variable.

The following shell commands prepare the default directory for group "users":
    QDIR=/var/spool/qdir
    sudo mkdir $QDIR
    sudo chgrp users $QDIR
    sudo chmod g+w $QDIR

Usage:
    # Add a job to the queue:
    qdir cmd [with optional arguments]
    # List the currently queued jobs:
    qdir
    # Dequeue a job or terminate its execution
    kill jobId
    # or
    rm /var/spool/qdir/jobId

Carl Osterwisch, January 2024
"""

import os
from os.path import exists
import pwd
from pathlib import Path
from signal import signal, SIGTERM
import subprocess
import sys
from time import sleep

qdir = Path(os.environ.get("QDIR", "/var/spool/qdir"))
if not qdir.is_dir():
    sys.exit(f"ERROR: The QDIR directory {qdir} does not exist")
if not os.access(qdir, os.W_OK):
    sys.exit(f"ERROR: The QDIR directory {qdir} is not writable")

interval = int(os.environ.get("QDIR_POLL_INTERVAL", 10))
if not interval > 0:
    sys.exit(f"The QDIR_POLL_INTERVAL {interval} must be seconds greater than 0")

verbose = int(os.environ.get("QDIR_VERBOSE", 2))

# collect set of active process Ids
if os.name == "nt":
    cmd = "WMIC process get processid"
else:
    cmd = ["pgrep", "python"]
processIds = {
    pid
    for pid in subprocess.check_output(cmd, universal_newlines=True).split()
    if pid.isnumeric()
}


def job_info(entry):
    """Return user and command to be run by the entry or empty string"""
    user = pwd.getpwuid(entry.stat().st_uid).pw_name  # TODO windows
    try:
        with open(entry.path) as f:
            cmd = f.readline().strip()
    except Exception:
        cmd = ""
    return "\t".join([entry.name, user, cmd])


def is_jobFile(entry):
    """Verify the entry is an active job file with a watching process"""
    if entry.name.isnumeric() and entry.is_file():
        if entry.name in processIds:
            return True
        print("Removing stale job", job_info(entry), sep="\t", file=sys.stderr)
        try:
            os.unlink(entry.path)
        except OSError as e:
            print(e, file=sys.stderr)


# create list of currently queued jobs, sorted oldest to newest
previousJobs = sorted(os.scandir(qdir), key=lambda entry: entry.stat().st_mtime_ns)
previousJobs = [entry for entry in previousJobs if is_jobFile(entry)]

if len(sys.argv) < 2:
    # list queued jobs and exit if no argument provided
    print("Queue directory", qdir)
    for n, entry in enumerate(previousJobs):
        user = pwd.getpwuid(entry.stat().st_uid).pw_name  # TODO windows
        print(n, job_info(entry), sep="\t")
    if not previousJobs:
        print("No jobs queued")
    sys.exit(0)

# fork to background
if os.fork():  # TODO windows
    os._exit(0)

jobId = str(os.getpid())  # process id of this script
cmd = " ".join(sys.argv[1:])  # command to be executed
job = None  # subprocess running the cmd, if any

# Create the job file in queue directory
with open(qdir / jobId, "w") as jobFile:
    os.environ["QDIR_FILE"] = jobFile.name  # will be exported to cmd
    print(jobFile.name)
    os.close(sys.stdout.fileno())  # allow shell to collect jobFile.name
    sys.stdout = open(os.devnull, "w")  # block further printing to stdout

    print(cmd, file=jobFile)  # for information only
    if previousJobs:
        print(
            "Queued behind",
            " ".join([entity.name for entity in previousJobs]),
            file=jobFile,
        )

def terminateJob(sig=None, frame=None):
    """Terminate this job if running or dequeue if not"""
    global job
    result = ""
    if exists(jobFile.name):
        os.unlink(jobFile.name)  # remove job file
    if hasattr(job, 'pid'):  # job is or was running
        try:
            # pass SIGTERM signal to all child processes in this process group
            os.killpg(os.getpgid(job.pid), SIGTERM)
            if verbose >= 2:
                result = "Killed"
        except ProcessLookupError:
            if verbose >= 1:
                if job.returncode is None or job.returncode <= 0:
                    result = "Done"
                else:
                    result = "Error"
    elif job is None and verbose >= 2:
        result = "Dequeued"
    if result:
        print(jobId, result, cmd, sep="\t", file=sys.stderr)
        job = result  # don't report result again


signal(SIGTERM, terminateJob)  # assign handler for SIGTERM

# Wait for all previousJobs to complete
previousJobs.reverse()  # check newest jobs first
while exists(jobFile.name) and any(
    map(exists, [entity.path for entity in previousJobs])
):
    sleep(interval)

# Launch the cmd if jobFile is still in queue
if exists(jobFile.name):
    logName = Path(cmd.split()[0]).stem + "._" + jobId
    with open(logName, "w") as logFile:
        try:
            job = subprocess.Popen(
                cmd,
                shell=True,
                start_new_session=True,
                stdout=logFile,
                stderr=subprocess.STDOUT,
            )
            while exists(jobFile.name) and job.poll() is None:
                sleep(interval)
        except Exception as e:
            print(e, file=logFile)

# Clean up
terminateJob()
