qFileSuffix = os.environ.get("QDIR_SUFFIX", ".qdir")
dprefix = os.environ.get(
    "QDIR_DPREFIX", os.environ.get("PBS_DPREFIX", "(#|@?(?i:rem ))(QDIR|PBS)")
)

