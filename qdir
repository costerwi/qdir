#!/bin/env python3
"""Implements first-in, first-out sequential job queue for the local machine.

The queue is maintained as a directory of job queue files.
A job will execute once all of the preceeding job queue files are deleted.
A finished job will delete its own job queue file which signals the next job to begin.
Users may manually delete job queue files to skip or terminate their corresponding jobs.

Multiple users may share the same queue directory to ensure one job is executed at a time among the group of users.
By default the script will use your TEMP directory but any convenient directory may be selected by defining the QDIR environment variable.

The following shell commands prepare the default directory for group "users":
    QDIR=/var/spool/qdir
    sudo mkdir $QDIR
    sudo chgrp users $QDIR
    sudo chmod g+w $QDIR

Usage:
    The behavior is different depending on the arguments

    # Add a job to the queue:
    qdir cmd [with optional arguments]

    # List the currently queued jobs:
    qdir

    # Dequeue or terminate a list of jobId numbers
    qdir jobId [jobId ...]

Carl Osterwisch, January 2024
"""

__version__ = "0.9.0"

import os
from os.path import exists
from pathlib import Path
import signal
import subprocess
import sys
from tempfile import gettempdir
from time import sleep, asctime, perf_counter


qdir = Path(os.environ.get("QDIR", gettempdir()))
if not qdir.is_dir():
    sys.exit(f"ERROR: The QDIR directory {qdir} does not exist")
if not os.access(qdir, os.W_OK):
    sys.exit(f"ERROR: The QDIR directory {qdir} is not writable")

if os.name == 'nt':
    try:
        import win32security
    except ImportError:
        sys.exit("pywin32 module is missing. Install with this command:\n"
            "pip3 install pywin32")
    def winOwner(self):
        sd = win32security.GetFileSecurity(str(self), win32security.OWNER_SECURITY_INFORMATION)
        owner_sid = sd.GetSecurityDescriptorOwner()
        name, domain, type = win32security.LookupAccountSid(None, owner_sid)
        return name
    try:
        owner = qdir.owner()
    except NotImplementedError:
        Path.owner = winOwner  # monkey patch if needed

interval = int(os.environ.get("QDIR_POLL_INTERVAL", 10))
if not interval > 0:
    sys.exit(f"The QDIR_POLL_INTERVAL {interval} must be seconds greater than 0")

verbose = int(os.environ.get("QDIR_VERBOSE", 2))


def job_info(jobFilePath):
    """Return jobId, user, and command to be run by the jobFilePath"""
    info = [jobFilePath.stem, jobFilePath.owner()]
    try:
        cmd = ""
        with jobFilePath.open() as f:
            for line in f:
                status = line.strip() # capture last line
                cmd = cmd or status # capture first line
        info.extend([cmd, status])
    except Exception as e:
        if verbose >= 3: print(e, file=sys.stderr)
    return info


def getQueuedJobs():
    "Return a list of jobFilePath for currently queued jobs, sorted oldest to newest"
    if os.name == 'nt':
        import win32process
        processIds = set(str(pid) for pid in win32process.EnumProcesses())
    else:
        cmd = ["pgrep", "python"]
        processIds = {
            pid
            for pid in subprocess.check_output(cmd, universal_newlines=True).split()
            if pid.isnumeric()
        }

    def is_jobFile(jobFilePath):
        """Verify the jobFilePath is an active job file with a watching process"""
        if not (jobFilePath.is_file() and jobFilePath.suffix == '.qdir'):
            return False
        if jobFilePath.stem in processIds:
            return True
        print("Removing orphaned job file", *job_info(jobFilePath), sep="\t", file=sys.stderr)
        try:
            jobFilePath.unlink()
        except OSError as e:
            print(e, file=sys.stderr)

    queuedJobs = [filePath for filePath in qdir.iterdir() if is_jobFile(filePath)]
    return sorted(queuedJobs, key=lambda jobFilePath: jobFilePath.stat().st_mtime)


def qstat():
    "Print a list of queued jobs"
    if verbose >= 2:
        print("Queue directory", qdir)
    queuedJobs = getQueuedJobs()
    if not queuedJobs:
        print("No jobs queued")
    else:
        if verbose >= 1:
            print("JobId", "User", "Command", sep="\t")
        for jobFilePath in queuedJobs:
            print(*job_info(jobFilePath), sep="\t")


def enqueue(cmd):
    "Submit cmd to the job queue"
    previousJobs = getQueuedJobs()
    if os.name == "posix":
        # fork to background TODO similar for windows
        if os.fork():
            os._exit(0)

    jobId = str(os.getpid())  # process id of this script
    job = None  # subprocess running the cmd, if any

    def terminateJob(sig=None, frame=None):
        """Terminate this job if running or dequeue if not"""
        nonlocal job
        result = ""
        runTime = ""
        if exists(jobFile.name):
            os.unlink(jobFile.name)  # remove job file
        if hasattr(job, 'pid'):  # job is or was running
            runTime = humanDuration(perf_counter() - job.startTime)
            if job.poll() is None:
                if verbose >= 2:
                    result = "Killed"
                if os.name == "posix":
                    # pass SIGTERM signal to all child processes in this process group
                    try:
                        os.killpg(os.getpgid(job.pid), signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                else:
                    job.send_signal(signal.CTRL_BREAK_EVENT)
                    sleep(interval)
                    job.terminate()
            elif verbose >= 1:
                if job.returncode <= 0:
                    result = "Done"
                else:
                    result = "Error"
        elif job is None and verbose >= 2:
            result = "Dequeued"
        if result:
            print(jobId, result, cmd, runTime, sep="\t", file=sys.stderr)
            job = result  # don't report result again

    signal.signal(signal.SIGTERM, terminateJob)  # assign handler for SIGTERM

    # Create the job file in queue directory
    with open((qdir/jobId).with_suffix(".qdir"), "w") as jobFile:
        os.environ["QDIR_FILE"] = jobFile.name  # will be exported to cmd
        status = "Queued " + asctime()
        if verbose >= 2:
            print(jobId, status, sep='\t')
        os.close(sys.stdout.fileno())  # allow shell to collect jobFile.name
        sys.stdout = open(os.devnull, "w")  # block further printing to stdout

        print(cmd, file=jobFile)  # jobFile contents are for information only
        if previousJobs:
            print(
                "Behind",
                " ".join([job.stem for job in previousJobs]),
                file=jobFile,
            )
        print(status, file=jobFile)

    # Wait for all previousJobs to complete
    previousJobs.reverse()  # check newest jobs first
    while exists(jobFile.name) and any(entry.exists() for entry in previousJobs):
        sleep(interval)

    # Launch the cmd if jobFile is still in queue
    if exists(jobFile.name):
        try:
            # Append the job starting status to jobFile
            stat = os.stat(jobFile.name)
            with open(jobFile.name, 'a') as jobFile:
                print('Started', asctime(), file=jobFile)
            # Keep mtime unchanged so the job files sort correctly
            os.utime(jobFile.name, (stat.st_atime, stat.st_mtime))
        except Exception:
            pass # ignore exceptions which might prevent the job from running
        logName = Path(cmd.split()[0]).with_suffix("._" + jobId)
        with open(logName, "w") as logFile:
            options = {}
            if os.name == "nt":
                options['creationflags'] = subprocess.CREATE_NEW_PROCESS_GROUP
            try:
                job = subprocess.Popen(
                    cmd,
                    shell=True,
                    start_new_session=True,
                    stdout=logFile,
                    stderr=subprocess.STDOUT,
                    **options,
                )
                job.startTime = perf_counter()
                while exists(jobFile.name) and job.poll() is None:
                    # job is still running
                    sleep(interval)
            except Exception as e:
                print(e, file=logFile)

    terminateJob() # Clean up at the end


def dequeueJobs(jobIdList):
    "Remove a list of jobIds from the queue"
    queuedJobs = getQueuedJobs()
    for jobId in jobIdList:
        jobPath = (qdir/str(jobId)).with_suffix(".qdir")
        if not jobPath in queuedJobs:
            print(jobId, 'is not queued')
        else:
            print('Dequeing', *job_info(jobPath), sep='\t')
            jobPath.unlink() # Just delete its jobFile


def humanDuration(seconds):
    for unit, per in ('days', 86400), ('hours', 3600), ('minutes', 60):
        if seconds >= 1.1*per:
            return('{:.2g} {}'.format(seconds/per, unit))
    return('{:.2g} seconds'.format(seconds))


if __name__ == "__main__":
    if len(sys.argv) < 2:
        # No arguments: Display a list of jobs in the queue
        qstat()
    elif all(arg.isnumeric() for arg in sys.argv[1:]):
        # All integer arguments: Dequeue these jobId numbers
        dequeueJobs(sys.argv[1:])
    else:
        # Enqueue a new command
        enqueue(" ".join(sys.argv[1:]))
