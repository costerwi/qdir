from __future__ import print_function, with_statement

# Define commands to compile user subroutines using GNU fortran
compile_fortran = ['gfortran',
    '-c',
    '-ffixed-line-length-none',
    '-fPIC',
    '-I%I',
    ]

link_sl = ['gfortran',
    '-fPIC', '-shared',
    '%E',  # Name of file containing names of exported symbols
    '-o', '%U',
    '%F',
    '%A',
    '%L', '%B',
    '-lifport',
    '-lifcoremt',
    '-lmpi',
    ]

# Abaqus env settings to configure runjob job queue
from string import Template
from driverQueues import Queue
class QDirQueue(Queue):
    """Submits jobs to a queue."""

    def __init__(self, name='runjob'):
        self.name = name

    def __repr__(self):
        return 'Submits to %r queue'%self.name

    def submit(self, options, env):
        "Create abaqus run script and print its full path to self.name printer"

        from os import chmod, environ
        from os.path import abspath
        from subprocess import call

        job = options['job']
        jobfname = '{0}.que'.format(job)

        with open(jobfname, 'w') as jobfile:
            print(self.template.substitute({
                'ABAQUS':environ.get('ABA_COMMAND', 'unknown'),
                'JOB': job,
                }), file=jobfile)
        try:
            chmod(jobfname, 0o775) # Set permissions
        except OSError:
            pass
    
        localenv = dict(env)
        if 'PYTHONPATH' in localenv:
            del localenv['PYTHONPATH']
        call('qdir "./{}"'.format(jobfname), shell=True, env=localenv)

QDirQueue.template = Template('''#!/bin/sh
JOB="$JOB"
ABAQUS=$ABAQUS

umask 0007
exec $$ABAQUS python -u "$$JOB.com"
''')

del print_function, with_statement, Template
queues['qdir'] = QDirQueue()
queues['default'] = queues['qdir']

# Default run mode (background, interactive, or batch) if the user does
# not specify the run mode on the abaqus command line.
run_mode = BATCH

