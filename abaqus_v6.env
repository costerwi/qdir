from __future__ import print_function, with_statement

# Abaqus env settings to configure qdir job queue
from driverQueues import Queue
class QDirQueue(Queue):
    """Submits jobs to a qdir queue."""

    def __init__(self, name='qdir'):
        import os
        from textwrap import dedent
        from string import Template
        self.name = name
        if os.name == 'posix':
            self.extension = '.sh'
            self.template = Template(dedent('''\
                #!/bin/sh
                #QDIR --name $job
                #QDIR --output {name}.log
                JOB="$job"
                ABAQUS=$abaqus
                cd $$(dirname $$0)

                let t=0
                while [[ -e "$$JOB.lck" && $$t != 60 ]]
                do
                    let t+=5
                    sleep 5
                    echo Paused $$t seconds for \"$$JOB.lck\" to clear
                done

                umask 0007
                exec $$ABAQUS python -u "$$JOB.com"
                '''))
        else:
            self.extension = '.cmd'
            self.template = Template(dedent('''\
                @rem QDIR --name $job
                @rem QDIR --output {name}.log
                set JOB=$job
                set ABAQUS=$abaqus
                cd %~dp0
                %ABAQUS% python -u %JOB%.com
                '''))

    def __repr__(self):
        return 'Submits to %r queue'%self.name

    def submit(self, options, env):
        "Create Abaqus job script and submit it to qdir"

        from os import chmod
        from os.path import join
        from subprocess import call

        job = options['job']
        jobfname = job + self.extension

        with open(jobfname, 'w') as jobFile:
            print(self.template.substitute(
                abaqus = env['ABA_COMMAND'],
                job = job,
                ), file=jobFile)
        try:
            chmod(jobfname, 0o775) # Set permissions
        except OSError:
            pass
    
        localenv = dict(env)
        if 'PYTHONPATH' in localenv:
            del localenv['PYTHONPATH'] # avoid conflicts
        call('qdir "./{}"'.format(jobfname), shell=True, env=localenv)

del print_function, with_statement

# Add an instance of QDirQueue to Abaqus queues
queues['qdir'] = QDirQueue()
queues.setdefault('default', queues['qdir'])

# Default run mode (background, interactive, or batch) if the user does
# not specify the run mode on the abaqus command line.
run_mode = BATCH

